{
    // VSCODE
    // window
    "window.menuBarVisibility": "toggle",
    "window.zoomLevel": 0.45,
    // workbench
    "workbench.colorTheme": "Solarized Light",
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "workbench.iconTheme": "material-icon-theme",
    "workbench.preferredDarkColorTheme": "Solarized Dark",
    "workbench.preferredLightColorTheme": "Solarized Light",
    "workbench.tree.renderIndentGuides": "none",
    // explorer
    "explorer.compactFolders": false,
    "explorer.sortOrder": "type",
    // editor
    "editor.cursorBlinking": "phase",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorStyle": "block",
    "editor.fontFamily": "'Cascadia Code NF', 'Cascadia Code', 'Consolas'",
    "editor.fontLigatures": "'calt', 'ss01', 'ss19'",
    "editor.fontSize": 14.75,
    "editor.fontWeight": "500",
    "editor.guides.indentation": false,
    "editor.inlineSuggest.enabled": true,
    "editor.insertSpaces": true,
    "editor.lineHeight": 16,
    "editor.lineNumbers": "relative",
    "editor.minimap.renderCharacters": false,
    "editor.minimap.showSlider": "always",
    "editor.renderFinalNewline": "on",
    "editor.rulers": [
        70,
        80,
        110
    ],
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "on",
    "editor.tabSize": 4,
    "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
    "editor.wordWrap": "off",
    // files
    "files.associations": {
        "*.livemd": "markdown"
    },
    "files.insertFinalNewline": true,
    // markdown
    "markdown.extension.toc.updateOnSave": false,
    // terminal
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.fontFamily": "'Cascadia Code NF', 'Cascadia Code PL', 'Consolas'",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.fontWeight": "500",
    "terminal.integrated.inheritEnv": false,
    "terminal.integrated.lineHeight": 1,
    "terminal.integrated.suggest.enabled": true,
    // theme
    "material-icon-theme.files.associations": {
        "CODEOWNERS": "Contributing",
        "CONDUCT.md": "Conduct",
        "CONTRIBUTE.md": "Contributing",
        "UNLICENSE.md": "Certificate",
        "WAIVER.md": "Contributing",
    },
    "material-icon-theme.folders.color": "#42a5f5",
    "material-icon-theme.folders.associations": {
        "Engineering": "Config",
        "Pipeline": "Azure-Pipelines",
        "Solution": "VSCode",
    },
    // copilot
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": false,
        "yaml": true
    },
    // vim
    "vim.cursorStylePerMode.insert": "line",
    "vim.cursorStylePerMode.normal": "block",
    "vim.cursorStylePerMode.replace": "underline",
    "vim.cursorStylePerMode.visual": "block-outline",
    "vim.cursorStylePerMode.visualblock": "block-outline",
    "vim.cursorStylePerMode.visualline": "block-outline",
    "vim.enableNeovim": true,
    "vim.foldfix": true,
    "vim.showMarksInGutter": true,
    // python
    "python.analysis.completeFunctionParens": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.typeCheckingMode": "standard",
    "python.languageServer": "Pylance",
    // ansible
    "ansible.lightspeed.enabled": false,
    "ansible.lightspeed.suggestions.enabled": false,
    // file type preferences
    "[ansible]": {
        "editor.detectIndentation": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.quickSuggestions": {
            "comments": true,
            "other": true,
            "strings": true
        },
        "editor.autoIndent": "advanced"
    },
    "[json]": {
        "editor.detectIndentation": false,
        "editor.quickSuggestions": {
            "strings": true
        },
        "editor.suggest.insertMode": "replace",
        "editor.tabSize": 2
    },
    "[markdown]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": false,
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.wordWrap": "off",
        "editor.quickSuggestions": {
            "comments": "off",
            "strings": "off",
            "other": "off"
        }
    },
    "[yaml,yml]": {
        "editor.detectIndentation": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced"
    },
}
