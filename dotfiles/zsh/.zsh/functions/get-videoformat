#! /usr/bin/env zsh

# get-videoformat: Display video codec format

[[ "$1" == "--help" ]] && echo "Usage: get-videoformat <file>" && return 0

# Validate argument
if [[ $# -lt 1 ]]; then
  echo "Error: Missing video file argument"
  return 1
fi

# Extract codec information
local _file="$1"
ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 ${_file} 2>/dev/null
