#! /usr/bin/env zsh

# test-sslhandshake: Test SSL/TLS handshake with a site

[[ "$1" == "--help" ]] && echo "Usage: test-sslhandshake <site>" && return 0

# Validate argument
if [[ $# -lt 1 || -z "$1" ]]; then
    echo "Error: Missing site argument"
    return 1
fi

# Test SSL connection
local _site=$1
openssl s_client -connect "${_site}":443 <<< "Q"
