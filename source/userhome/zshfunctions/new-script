#!/usr/bin/env python3

"""
Script: new-script
Author: axler8r.io
Description: Generates a new zsh automation script from a template
Version: 1.0
"""

import argparse
import sys
from datetime import datetime
from typing import NoReturn


class Colors:
    """ANSI color codes for terminal output"""
    RED = '\033[0;31m'
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    BLUE = '\033[0;34m'
    NC = '\033[0m'  # No Color


class Logger:
    """Simple logging utility"""

    def __init__(self, verbose: bool = False):
        self.verbose = verbose

    def info(self, message: str) -> None:
        print(f"{Colors.BLUE}[INFO]{Colors.NC} {message}", file=sys.stderr)

    def error(self, message: str) -> None:
        print(f"{Colors.RED}[ERROR]{Colors.NC} {message}", file=sys.stderr)

    def verbose_log(self, message: str) -> None:
        if self.verbose:
            print(f"{Colors.BLUE}[VERBOSE]{Colors.NC} {message}", file=sys.stderr)


def error_exit(message: str, exit_code: int = 1) -> NoReturn:
    """Print error message and exit"""
    Logger().error(message)
    sys.exit(exit_code)


def generate_script_template(script_name: str, verbose: bool = False) -> str:
    """Generate the Python script template"""
    logger = Logger(verbose)
    current_date = datetime.now().strftime('%Y-%m-%d')

    logger.verbose_log(f"Generating template for script: {script_name}")

    template = f'''#!/usr/bin/env zsh

# Script: script-name
# Author: Your Name
# Description: Brief description of what this script does
# Version: 1.0
# Created: $(date +%Y-%m-%d)

set -euo pipefail  # Exit on error, undefined vars, pipe failures

# Script metadata
readonly SCRIPT_NAME="${0:t}"
readonly SCRIPT_DIR="${0:A:h}"
readonly VERSION="1.0"

# Default values
typeset -i VERBOSE=0
typeset -i DRY_RUN=0
typeset -i FORCE=0

# Color codes for output
readonly RED="\033[0;31m"
readonly GREEN="\033[0;32m"
readonly YELLOW="\033[1;33m"
readonly BLUE="\033[0;34m"
readonly NC="\033[0m" # No Color

#==============================================================================
# Functions
#==============================================================================

show_synopsis() {
    cat << EOF
SYNOPSIS
    ${SCRIPT_NAME} [OPTIONS] [ARGUMENTS]

    Brief one-line description of what the script does.
EOF
}

show_help() {
    show_synopsis
    cat << EOF

DESCRIPTION
    Detailed description of what this script does and its purpose.

    This script performs automation tasks such as...

OPTIONS
    -h, --help      Show this help message and exit
    -v, --verbose   Enable verbose output
    -V, --version   Show version information
    -n, --dry-run   Show what would be done without actually doing it
    -f, --force     Force operation without confirmation prompts

ARGUMENTS
    arg1            Description of first argument
    arg2            Description of second argument (optional)

EXAMPLES
    ${SCRIPT_NAME} --verbose file.txt
    ${SCRIPT_NAME} --dry-run --force /path/to/directory

EXIT CODES
    0    Success
    1    General error
    2    Invalid arguments
    64   Usage error

AUTHOR
    Your Name <your.email@example.com>

VERSION
    ${VERSION}
EOF
}

show_version() {
    echo "${SCRIPT_NAME} version ${VERSION}"
}

# Logging/output functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $*" >&2
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $*" >&2
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $*" >&2
}

log_verbose() {
    [[ ${VERBOSE} -eq 1 ]] && echo -e "${BLUE}[VERBOSE]${NC} $*" >&2
}

# Error handling
error_exit() {
    local exit_code=${2:-1}
    log_error "$1"
    exit ${exit_code}
}

# Confirmation prompt (when not using --force)
confirm() {
    if [[ ${FORCE} -eq 1 ]]; then
        return 0
    fi

    local message="$1"
    echo -n "${message} (y/N): "
    read -r response
    case ${response} in
        [yY]|[yY][eE][sS]) return 0 ;;
        *) return 1 ;;
    esac
}

# Check if required commands exist
check_dependencies() {
    local missing_deps=()
    local deps=("command1" "command2")  # Add your required commands here

    for dep in "${deps[@]}"; do
        if ! command -v "${dep}" >/dev/null 2>&1; then
            missing_deps+=("${dep}")
        fi
    done

    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        error_exit "Missing required dependencies: ${missing_deps[*]}" 2
    fi
}

# Cleanup function (called on EXIT)
cleanup() {
    log_verbose "Cleaning up..."
    # Add cleanup code here (remove temp files, etc.)
}

#==============================================================================
# Main Functions
#==============================================================================

# Your main logic functions go here
main_task() {
    local arg1="$1"
    local arg2="${2:-}"  # Optional second argument

    log_verbose "Starting main task with arg1='${arg1}', arg2='${arg2}'"

    if [[ ${DRY_RUN} -eq 1 ]]; then
        log_info "DRY RUN: Would perform task with ${arg1}"
        return 0
    fi

    # Add your main logic here
    log_info "Performing task..."

    # Example of confirmation for potentially destructive operations
    if ! confirm "This will modify ${arg1}. Continue?"; then
        log_info "Operation cancelled by user"
        return 0
    fi

    # Your actual work here
    log_success "Task completed successfully"
}

#==============================================================================
# Argument Parsing
#==============================================================================

parse_arguments() {
    # Parse options using zparseopts
    local -a opts
    zparseopts -D -E -a opts \
        h=opts -help=opts \
        v=opts -verbose=opts \
        V=opts -version=opts \
        n=opts -dry-run=opts \
        f=opts -force=opts \
        || error_exit "Invalid option. Use -h for help." 64

    # Process parsed options
    for opt in "${opts[@]}"; do
        case ${opt} in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--verbose)
                VERBOSE=1
                ;;
            -V|--version)
                show_version
                exit 0
                ;;
            -n|--dry-run)
                DRY_RUN=1
                ;;
            -f|--force)
                FORCE=1
                ;;
        esac
    done

    # Remaining arguments are in $@
    if [[ $# -eq 0 ]]; then
        show_synopsis
        error_exit "Missing required arguments. Use -h for help." 64
    fi
}

#==============================================================================
# Main Script
#==============================================================================

main() {
    # Set up error handling and cleanup
    trap cleanup EXIT
    trap 'error_exit "Script interrupted" 130' INT TERM

    # Parse command line arguments
    parse_arguments "$@"

    # Check dependencies
    check_dependencies

    # Show configuration in verbose mode
    log_verbose "Configuration:"
    log_verbose "  Verbose: ${VERBOSE}"
    log_verbose "  Dry run: ${DRY_RUN}"
    log_verbose "  Force: ${FORCE}"
    log_verbose "  Arguments: $*"

    # Call main task with remaining arguments
    main_task "$@"
}

# Only run main if script is executed directly (not sourced)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]] || [[ "${ZSH_EVAL_CONTEXT}" == "toplevel" ]]; then
    main "$@"
fi

'''
    return template


def create_argument_parser() -> argparse.ArgumentParser:
    """Create and configure argument parser"""
    parser = argparse.ArgumentParser(
        prog='new-script',
        description='Generate a new Python automation script from template',
        epilog="""
Examples:
  new-script my-automation > ~/bin/my-automation
  new-script deploy-app > scripts/deploy-app
  new-script --verbose backup-system > /usr/local/bin/backup-system

Exit codes:
  0    Success
  1    General error
  64   Usage error

Author: Script Template Generator
Version: 1.0
        """,
        formatter_class=argparse.RawDescriptionHelpFormatter
    )

    parser.add_argument(
        '-v', '--verbose',
        action='store_true',
        help='Enable verbose output'
    )

    parser.add_argument(
        '-V', '--version',
        action='version',
        version='new-script version 1.0'
    )

    parser.add_argument(
        'script_name',
        help='Name of the script to generate (without extension)'
    )

    return parser


def main() -> None:
    """Main function"""
    try:
        parser = create_argument_parser()
        args = parser.parse_args()

        logger = Logger(args.verbose)
        logger.verbose_log(f"Creating template for script: {args.script_name}")

        # Generate and output the template
        template = generate_script_template(args.script_name, args.verbose)
        print(template)

        logger.verbose_log("Template generated successfully")

    except KeyboardInterrupt:
        error_exit("Script interrupted", 130)
    except Exception as e:
        error_exit(f"Unexpected error: {e}")


if __name__ == "__main__":
    main()
