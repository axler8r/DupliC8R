alias -s {pdf,ps}=evince


alias -g B="| bat --paging=auto - "
alias -g C="| wc --lines - "
alias -g G="| grep "
alias -g L="| less --line-numbers "
alias -g R="| rg "
alias -g S="| sed --expression "
alias -g V="| nvim - "

function ls() {
	[[ -f ~/.hidden ]] && declare GLOBIGNORE=${GLOBIGNORE}:.*:$(tr '\n' ':' < ~/.hidden) ls "$@"
}
