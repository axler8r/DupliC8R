{
	"name": "DuplIC8R",
	"image": "mcr.microsoft.com/devcontainers/base:jammy",
	"containerEnv": {
		"IN_CONTAINER": "true"
	},
	"features": {
		"ghcr.io/devcontainers-extra/features/apt-packages:1": {
			"packages": [
				"ansible-core",
				"ansible-lint"
			]
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"redhat.ansible",
				"ms-python.python",
				"redhat.vscode-yaml"
			]
		}
	}
}
